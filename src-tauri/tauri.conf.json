{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dark Project Studio",
  "version": "0.12.4",
  "identifier": "dev.darkproject.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dark Project Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "backgroundColor": "#0c0c0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Профили, подсветка и клавиши Dark Project KD3B",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
