{
  "name": "dark-project-studio",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "npm run presets && tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test \"ui/src/**/*.test.ts\"",
